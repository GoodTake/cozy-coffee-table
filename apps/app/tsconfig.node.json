{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // `composite` forces emit, and without an outDir `tsc -b` (npm run build)
    // drops vite.config.js + vite.config.d.ts next to vite.config.ts. Vite
    // resolves .js BEFORE .ts, so from the first build onward the dev server
    // silently reads a frozen copy and every later edit to vite.config.ts has
    // no effect. Keep the emit out of the project root.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["vite.config.ts", ".steps/visual-edit/**/*.ts"]
}
