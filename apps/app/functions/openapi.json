{
  "openapi": "3.1.0",
  "info": {
    "title": "The Cozy Coffee Table API",
    "version": "1.0.0",
    "description": "Menu, barista's note, today's special and table bookings for The Cozy Coffee Table."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check service health",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "The service is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/note": {
      "get": {
        "operationId": "getBaristaNote",
        "summary": "Get the barista's note of the day",
        "tags": [
          "Cafe"
        ],
        "responses": {
          "200": {
            "description": "Today's note, written once a day.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "note",
                    "barista"
                  ],
                  "properties": {
                    "note": {
                      "type": "string"
                    },
                    "barista": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "The note could not be written.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/menu": {
      "get": {
        "operationId": "getMenu",
        "summary": "Get the menu",
        "tags": [
          "Cafe"
        ],
        "responses": {
          "200": {
            "description": "Drinks and pastries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "drinks",
                    "pastries"
                  ],
                  "properties": {
                    "drinks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "description",
                          "price"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "price": {
                            "type": "integer",
                            "description": "Price in pence."
                          }
                        }
                      }
                    },
                    "pastries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "description",
                          "price"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "price": {
                            "type": "integer",
                            "description": "Price in pence."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/specials/today": {
      "get": {
        "operationId": "getTodaysSpecial",
        "summary": "Get today's special",
        "tags": [
          "Cafe"
        ],
        "responses": {
          "200": {
            "description": "Today's special.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "name",
                    "description",
                    "price",
                    "kind"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "price": {
                      "type": "integer"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "drink",
                        "pastry"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/specials/today.svg": {
      "get": {
        "operationId": "getTodaysSpecialPicture",
        "summary": "Get the picture of today's special",
        "tags": [
          "Cafe"
        ],
        "responses": {
          "200": {
            "description": "An SVG picture.",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "operationId": "createBooking",
        "summary": "Book a table",
        "tags": [
          "Bookings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "date",
                  "time",
                  "partySize"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "time": {
                    "type": "string",
                    "example": "10:30"
                  },
                  "partySize": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The table is booked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "booking",
                    "emailSent",
                    "message"
                  ],
                  "properties": {
                    "booking": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "date",
                        "time",
                        "partySize"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string"
                        },
                        "time": {
                          "type": "string"
                        },
                        "partySize": {
                          "type": "integer"
                        }
                      }
                    },
                    "emailSent": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The form has a problem.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listTodaysBookings",
        "summary": "List today's bookings for staff (no guest emails)",
        "tags": [
          "Bookings"
        ],
        "responses": {
          "200": {
            "description": "Today's bookings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "date",
                    "bookings"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "bookings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "time",
                          "partySize"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "time": {
                            "type": "string",
                            "example": "10:30"
                          },
                          "partySize": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings.csv": {
      "get": {
        "operationId": "exportBookingsCsv",
        "summary": "Export every booking as CSV (no guest emails)",
        "tags": [
          "Bookings"
        ],
        "responses": {
          "200": {
            "description": "CSV with date, time, name, party_size and booked_at.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
