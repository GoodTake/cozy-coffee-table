{
  "templates": [
    {
      "templateId": "booking-confirmed",
      "html": "<div style=\"background:#fbf5ec;padding:32px 16px;font-family:Georgia,'Times New Roman',serif;color:#2e1f17\"><div style=\"max-width:520px;margin:0 auto;background:#fffaf2;border-radius:18px;padding:32px;border:1px solid #ead8c1\"><p style=\"margin:0 0 8px;font-family:Arial,sans-serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#7d8f69\">{{shop}}</p><h1 style=\"margin:0 0 16px;font-size:28px;line-height:1.2\">Your table is booked</h1><p style=\"margin:0 0 16px;font-family:Arial,sans-serif;font-size:16px;line-height:1.6\">Hi {{name}}, thank you for booking with us. Here are the details:</p><table role=\"presentation\" style=\"width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:16px;margin:0 0 20px\"><tr><td style=\"padding:10px 0;border-bottom:1px solid #ead8c1;color:#7d8f69\">When</td><td style=\"padding:10px 0;border-bottom:1px solid #ead8c1;text-align:right;font-weight:bold\">{{when}}</td></tr><tr><td style=\"padding:10px 0;border-bottom:1px solid #ead8c1;color:#7d8f69\">Table for</td><td style=\"padding:10px 0;border-bottom:1px solid #ead8c1;text-align:right;font-weight:bold\">{{guests}}</td></tr></table><p style=\"margin:0;font-family:Arial,sans-serif;font-size:16px;line-height:1.6\">We look forward to seeing you at 14 Linden Row.</p></div></div>",
      "manifest": {
        "subject": "Your table at {{shop}}",
        "slots": {
          "name": {
            "type": "text"
          },
          "when": {
            "type": "text"
          },
          "guests": {
            "type": "text"
          },
          "shop": {
            "type": "text"
          }
        }
      }
    }
  ]
}
